import { useState } from 'react'

const Statistics = (props) => {
  const yhteensä = props.hyvä + props.neutraali + props.huono

  if (yhteensä === 0) {
    return (
      <div>
        <p>Ei palautetta annettu</p>
      </div>
    )
  }

  const keskiarvo =
    (props.hyvä - props.huono) / yhteensä

  const positiivisia =
    (props.hyvä / yhteensä) * 100

  return (
    <div>
      <h1>Tilastot</h1>

      <div>hyvä {props.hyvä}</div>
      <div>neutraali {props.neutraali}</div>
      <div>huono {props.huono}</div>
      <div>yhteensä {yhteensä}</div>
      <div>keskiarvo {keskiarvo}</div>
      <div>positiivisia {positiivisia} %</div>
    </div>
  )
}

const App = () => {
  const [hyvä, setHyvä] = useState(0)
  const [neutraali, setNeutraali] = useState(0)
  const [huono, setHuono] = useState(0)

  return (
    <div>
      <h1>Anna palautetta</h1>

      <button onClick={() => setHyvä(hyvä + 1)}>
        hyvä
      </button>

      <button onClick={() => setNeutraali(neutraali + 1)}>
        neutraali
      </button>

      <button onClick={() => setHuono(huono + 1)}>
        huono
      </button>

      <Statistics
        hyvä={hyvä}
        neutraali={neutraali}
        huono={huono}
      />
    </div>
  )
}

export default App
